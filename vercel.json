{
  "rewrites": [
    {
      "source": "/:view(dashboard|focus|missions|projects|roadmap|today|calendar|challenges|tasks|history|insights|review|journal|notes|loved-ones|assistant|settings|apps|crm|problems)",
      "destination": "/index.html"
    },
    {
      "source": "/team/:view(missions|calendar|tasks|crm|problems|notes|settings)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
